# Root environment example for the full stack (docker compose).
# Copy to .env to override the defaults baked into docker-compose.yml.

# --- Backend runtime ---
APP_ENV=prod
LOG_LEVEL=INFO

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- Redis cache (ephemeral optimization) ---
# Inside compose the host is the service name "redis".
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=600
CACHE_COORD_PRECISION=2

# --- MongoDB persistence (system of record) ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=weather
HISTORY_MAX_ITEMS=20

# --- Open-Meteo upstreams (keyless, CC BY 4.0) ---
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# --- httpx upstream timeouts (seconds) ---
HTTP_CONNECT_TIMEOUT=3.0
HTTP_READ_TIMEOUT=8.0

# --- tenacity retry ---
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_BACKOFF=0.2
RETRY_MAX_BACKOFF=2.0

# --- pybreaker circuit breaker (per upstream) ---
BREAKER_FAIL_MAX=5
BREAKER_RESET_TIMEOUT=30

# --- /health upstream probe timeout (seconds) ---
HEALTH_UPSTREAM_TIMEOUT=2.0

# --- Frontend (Next.js) ---
# NEXT_PUBLIC_* values are inlined at build time, so they are passed as build
# args in docker-compose.yml rather than read at runtime. The browser reaches
# the backend on the host-published port, not the compose network name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_CITY=London
