# Runtime
APP_ENV=dev
LOG_LEVEL=INFO

# CORS: comma-separated list of allowed frontend origins (Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# Redis cache (ephemeral optimization, never the system of record)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=600
CACHE_COORD_PRECISION=2

# MongoDB persistence (system of record for favorites and history)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=weather

# Search history cap per client
HISTORY_MAX_ITEMS=20

# Open-Meteo upstream base URLs (keyless, CC BY 4.0)
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# httpx upstream timeouts (seconds)
HTTP_CONNECT_TIMEOUT=3.0
HTTP_READ_TIMEOUT=8.0

# tenacity retry policy
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_BACKOFF=0.2
RETRY_MAX_BACKOFF=2.0

# pybreaker circuit breaker (per upstream)
BREAKER_FAIL_MAX=5
BREAKER_RESET_TIMEOUT=30

# /health upstream probe timeout (seconds)
HEALTH_UPSTREAM_TIMEOUT=2.0
